{
  "expo": {
    "name": "صلاتك",
    "slug": "salatiq-ios-local",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "salatiq",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "نحتاج إلى الكاميرا الأمامية لمتابعة وضعيات الصلاة محليًا على جهازك دون إرسال الصور.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-asset",
        { "assets": ["./assets/audio/subhan_allah.mp3"] }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "ios": {
            "backgroundColor": "#FDFAEC",
            "image": "./assets/startup/mark.png",
            "imageWidth": 184,
            "resizeMode": "contain",
            "dark": {
              "backgroundColor": "#FDFAEC",
              "image": "./assets/startup/mark.png"
            }
          },
          "android": {
            "backgroundColor": "#FDFAEC",
            "image": "./assets/startup/mark.png",
            "imageWidth": 184,
            "resizeMode": "contain",
            "dark": {
              "backgroundColor": "#FDFAEC",
              "image": "./assets/startup/mark.png"
            }
          }
        }
      ],
      "./plugins/withLocalClassification",
      "expo-font",
      "./plugins/withSalatiqIOS"
    ],
    "ios": {
      "userInterfaceStyle": "automatic",
      "bundleIdentifier": "com.kosaai.salatiq",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDisplayName": "صلاتك",
        "CFBundleName": "Salatiq",
        "NSCameraUsageDescription": "نحتاج إلى الكاميرا الأمامية لمتابعة وضعيات الصلاة محليًا على جهازك دون إرسال الصور.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {}
    },
    "android": {
      "package": "com.kosaai.salatiq",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/branding/salatiq-logo-dark.png"
    }
  }
}
